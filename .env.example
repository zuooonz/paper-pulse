# 应用：服务绑定、配置路径、时区与跨域来源
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000
# 前端服务端访问后端的地址。本地开发默认 http://127.0.0.1:8000；Compose 中默认 http://api:8000，通常无需设置。
# BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Shanghai
WORKSPACE=.
CONFIG_DIR=config
# 可选：覆盖 config/imports.yaml 中的 doi.mark_as_target
# DOI_IMPORT_MARK_AS_TARGET=false
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOMAIN_CONFIG=
TAXONOMY_CONFIG=
ENTITIES_CONFIG=

# 数据库：可用 SQLAlchemy URL 覆盖默认 SQLite 文件
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
# 可选 PostgreSQL SQL 语句时限（毫秒）；0 表示使用数据库默认值，不影响 SQLite。
DB_STATEMENT_TIMEOUT_MS=0

# 后台任务：API 仅入队，worker 执行；RUN_SCHEDULER_IN_API 仅供单进程开发兼容
JOBS_INLINE=false
JOBS_POLL_INTERVAL=1
JOBS_HEARTBEAT_INTERVAL=30
JOBS_LEASE_TIMEOUT=300
# 检索子进程的最长执行秒数，默认 6 小时；超时后会终止子进程树。
LITERATURE_SEARCH_TIMEOUT_SECONDS=21600
RUN_SCHEDULER_IN_API=false
# 将卡在发布中的任务判为超时的分钟数。
PUBLISH_STUCK_MINUTES=30
# API、worker 和调度器的日志级别。
LOG_LEVEL=INFO
UVICORN_WORKERS=1
# 空闲连接保持秒数，需大于前端代理复用连接的时间，避免偶发 "socket hang up"
UVICORN_KEEP_ALIVE=75
# 设为 1 可跳过脚本启动时的数据库迁移。
PAPER_PULSE_NO_MIGRATE=0
WORKER_REPLICAS=1
WORKER_CONCURRENCY=1
WORKER_KINDS=publish_draft,publish_video,literature_search,poll_download,summary_job,cookie_validation,reconcile_pdf_flags
# 终态任务保留天数；设为 0 关闭清理。
JOB_RETENTION_DAYS=30
# PDF 文件可用标志的定期核对间隔（小时）；设为 0 可关闭。
PDF_FLAG_RECONCILE_HOURS=24

# 认证：请自行设置随机 JWT 密钥。LOCAL_*_PASSWORD 建议填写 `python -m api.hash_password` 输出的哈希串。
# 应用默认兼容旧明文密码；本模板推荐关闭。迁移期间可临时设为 true，全部改为哈希后设为 false。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
# 递增此值可使所有已签发 JWT 立即失效（需重启 API）。
JWT_TOKEN_VERSION=1
ALLOW_PLAINTEXT_PASSWORDS=false
# 前端 NextAuth 的 httpOnly 会话签名密钥；Compose 的 web 服务从同一 .env 读取。
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Docker/Compose 推荐直接设置下面的 LOCAL_*_PASSWORD（PBKDF2 哈希）。
# 也可以设置 LOCAL_USERS 为完整 JSON；若挂载了 config/runtime.yaml，则以 runtime.yaml 为准。
# LOCAL_USERS=
# 密码哈希含 $，请用单引号包住：LOCAL_ADMIN_PASSWORD='pbkdf2_sha256$...'
LOCAL_ADMIN_PASSWORD=
LOCAL_REVIEWER_PASSWORD=
LOCAL_VIEWER_PASSWORD=
LOCAL_LIMITED_PASSWORD=

# LLM：兼容 OpenAI Chat Completions 的服务
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=example-chat-model

# 文献 API：未启用的数据源对应凭据可留空
ELSEVIER_API_KEY=
ELSEVIER_BASE_URL=
IEEE_API_KEY=
IEEE_BASE_URL=
IEEE_XPLORE_BASE_URL=
WILEY_TDM_TOKEN=
WILEY_BASE_URL=
UNPAYWALL_EMAIL=
UNPAYWALL_BASE_URL=
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=
SPRINGER_API_KEY=
SPRINGER_BASE_URL=
CROSSREF_MAILTO=
CROSSREF_BASE_URL=
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_BASE_URL=
EUROPE_PMC_BASE_URL=
EUROPE_PMC_ARTICLE_BASE_URL=
ARXIV_BASE_URL=
DOI_RESOLVER_BASE_URL=
MDPI_BASE_URL=
OPENALEX_BASE_URL=
MINERU_BASE_URL=
MINERU_API_TOKEN=
CONTACT_EMAIL=
NOMINATIM_BASE_URL=

# 地图：仅在使用对应地理编码服务时需要
AMAP_API_KEY=
AMAP_BASE_URL=
BAIDU_MAP_AK=
BAIDU_MAP_BASE_URL=

# 钉钉：可选登录集成
DINGTALK_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_BASE_URL=
DINGTALK_OPEN_API_BASE_URL=

# 发布与浏览器自动化
PLAYWRIGHT_HEADLESS=true
PUBLISH_DEBUG_DIR=tmp/publish_debug
PUBLISH_CHANNEL_TIMEOUT_SECONDS=480
# 使用 `python -m publisher.credential_store --generate-key` 生成 Fernet 密钥并妥善保存；缺少密钥时拒绝保存凭据。
CREDENTIALS_ENCRYPTION_KEY=
# 仅用于本地临时开发；允许无密钥明文保存渠道凭据。生产环境保持 false。
ALLOW_PLAINTEXT_CREDENTIALS=false
# 默认拒绝下载私有、回环、链路本地等非公网地址。仅在可信内网环境按需启用。
ALLOW_PRIVATE_NETWORK_DOWNLOADS=false
# 参考数据：数据库由使用者提供；此处不下载或包含数据文件
REFERENCE_CONFIG=config/reference.yaml
# 留空时本地使用 config/reference.yaml，Docker Compose 默认使用镜像内的 /app/reference/jcr.db
JOURNAL_METRICS_DB=

# 存储：STORAGE_ROOT 为公共根目录；PDF_ROOT、OUTPUT_ROOT 可填写相对工作区或绝对路径，OUTPUT_ROOT 用于生成文件
STORAGE_ROOT=data
PDF_ROOT=
OUTPUT_ROOT=output
PDF_MAX_UPLOAD_MB=100
WORD_MAX_UPLOAD_MB=50
VIDEO_MAX_UPLOAD_MB=2048
COVER_MAX_UPLOAD_MB=20

# 可选视频生成服务
VIDEO_API_URL=
VIDEO_STATUS_URL_TEMPLATE=
VIDEO_API_TOKEN=
VIDEO_MODEL=
